{
    "schemaVersion": 1,
    "id": "bedrockores",
    "version": "${version}",
    "name": "Bedrock Ores",
    "description": "Large ore deposits embedded in the bedrock.",
    "authors": [
        "Sangar"
    ],
    "contact": {
        "issues": "https://github.com/MightyPirates/BedrockOres/issues",
        "sources": "https://github.com/MightyPirates/BedrockOres"
    },
    "license": "MIT",
    "environment": "*",
    "entrypoints": {
        "main": [
            "li.cil.bedrockores.fabric.BedrockOresFabric"
        ],
        "client": [
            "li.cil.bedrockores.client.fabric.BedrockOresFabricClient"
        ]
    },
    "mixins": [
        "bedrockores.mixins.json"
    ],
    "depends": {
        "fabric-api": ">=${fabricApiVersion}",
        "architectury": ">=${architecturyVersion}",
        "forgeconfigapiport": ">=${forgeConfigPortVersion}",
        "minecraft": ">=${minecraftVersion}",
        "java": ">=21"
    },
    "custom": {
        "mc-publish": {
            "modrinth": "KCMBVtfE",
            "curseforge": 275083,
            "dependencies": [
                "fabric-api@>=${fabricApiVersion}(required){modrinth:P7dR8mSH}{curseforge:306612}",
                "architectury@>=${architecturyVersion}(required){modrinth:lhGA9TYQ}{curseforge:419699}",
                "forge-config-api-port@>=${forgeConfigPortVersion}(required){modrinth:ohNO6lps}{curseforge:547434}"
            ]
        }
    }
}
